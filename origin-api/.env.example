# OriginChain Chat configuration. Copy to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# OriginChain datastore (the MCP server reads these)
OC_HOST=https://<tenant>.<region>.db.originchain.ai
OC_TENANT=<tenant>
OC_TOKEN=oc_live_...

# Tool-calling LLM (Groq — GenChat's instant model)
GROQ_API_KEY=gsk_...

# Cosavu ContextAPI (optimizes the retrieved context)
COSAVU_API_KEY=csvu_...

# Optional
# TNSA_API_KEY=tnsa_...                 # x-api-key for NGen, if your endpoint needs it
# ORIGIN_CHAIN_MODEL=NGen-4-Mini        # NGen answer model
# ORIGIN_CHAIN_TOOL_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
